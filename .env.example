# Supabase project credentials.
# Leave these unset to run the site in demo mode: RSVP, wishlist reservations,
# gallery uploads and the admin dashboard all work against local demo data
# (persisted to localStorage) instead of a real database. See README.md.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only — used by the /api routes (never sent to the browser).
# Required for the confirmation email + .ics flow; the RSVP form itself
# still works without these (it just won't be able to trigger an email).
#
# SUPABASE_SERVICE_ROLE_KEY: Supabase dashboard → Project Settings → API →
#   "service_role" secret key. Bypasses Row Level Security — never expose
#   this in client code or commit it.
# RESEND_API_KEY: resend.com → API Keys.
# EMAIL_FROM: a verified sender on your Resend domain, e.g.
#   "Victors konfirmation <hej@dit-domæne.dk>" (see README for domain setup).

SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
EMAIL_FROM=
